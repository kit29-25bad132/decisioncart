# DecisionCart — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ===========================================
# AI Service (LLM Provider)
# ===========================================
# Choose one: OpenAI, Anthropic, Google, etc.
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o

# ===========================================
# Razorpay (Payment Gateway)
# ===========================================
# Use test mode keys during development
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ===========================================
# Application
# ===========================================
# Server port
PORT=3000

# Session secret (generate a random 32+ character string)
SESSION_SECRET=change_this_to_a_random_secret_string

# Environment
NODE_ENV=development

# ===========================================
# Database (for catalog and audit)
# ===========================================
# SQLite for development
DATABASE_URL=file:./dev.db

# PostgreSQL for production
# DATABASE_URL=postgresql://user:password@localhost:5432/decisioncart

# ===========================================
# Security Notes
# ===========================================
# - NEVER commit .env to version control
# - NEVER expose AI_API_KEY or RAZORPAY_KEY_SECRET to the client
# - RAZORPAY_KEY_ID is safe to expose (it's the public key)
# - SESSION_SECRET should be a cryptographically random string
# - Generate a strong secret: openssl rand -base64 32
