# DecisionCart — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ===========================================
# AI Service (LLM Provider)
# ===========================================
# Choose one: OpenAI, Anthropic, Google, etc.
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o

# ===========================================
# Razorpay (Payment Gateway)
# ===========================================
# Use test mode keys during development
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ===========================================
# Application
# ===========================================
# Server port
PORT=3000

# Session secret (generate a random 32+ character string)
SESSION_SECRET=change_this_to_a_random_secret_string

# Environment
NODE_ENV=development

# ===========================================
# Database (for catalog and audit)
# ===========================================
# SQLite for development
DATABASE_URL=file:./dev.db

# PostgreSQL for production
# DATABASE_URL=postgresql://user:password@localhost:5432/decisioncart

# ===========================================
# Supabase (Persistence & Database)
# ===========================================
# Your Supabase project URL (public, safe for client use)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase publishable (anon) key — safe for client-side
# authenticated access. Currently unused; reserved for the
# authentication milestone.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase service role key — SERVER ONLY. This key bypasses
# Row Level Security and has full database access. It must
# NEVER be exposed via NEXT_PUBLIC_ or to client components.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# Security Notes
# ===========================================
# - NEVER commit .env to version control
# - NEVER expose AI_API_KEY or RAZORPAY_KEY_SECRET to the client
# - RAZORPAY_KEY_ID is safe to expose (it's the public key)
# - SESSION_SECRET should be a cryptographically random string
# - Generate a strong secret: openssl rand -base64 32
# - SUPABASE_SERVICE_ROLE_KEY must NEVER be prefixed with NEXT_PUBLIC_
# - NEVER import src/lib/supabase/server.ts from client components
